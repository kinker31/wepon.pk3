	StaticText "$F1_ID24B", "Gray"
	StaticText "$F2_ID24W", "Gray"
	StaticText "$F2_ID24B", "Gray"
	StaticText ""
	Option "$CELLSPAWN", "cellfuelchance", "chanceoptions", "id24crap"
