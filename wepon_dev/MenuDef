	StaticText "$F1_CELLSPAWNB", "Gray"
	StaticText "$F2_CELLSPAWN", "Gray"
	StaticText "$F2_CELLSPAWNB", "Gray"
	StaticText ""
	Option "$CELLSYSTEM", "cellsystem", "onoff"
	StaticText "$F1_CELLSYSTEM", "Gray"
	StaticText "$F1_CELLSYSTEMB", "Gray"
	StaticText "$F2_CELLSYSTEM", "Gray"
	StaticText "$F2_CELLSYSTEMB", "Gray"
	StaticText ""
	Option "$BFGSPAWN", "bfgcellchance", "chanceoptions", "cellsystem"
