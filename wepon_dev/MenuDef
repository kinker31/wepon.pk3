ListMenu "MainMenu" 
{
	StaticPatch 90, -3, "M_DOOM"
	Position 90, 76
	CenterMenu
	TextItem "$START_WEPON", 'n', "PlayerclassMenu"
	TextItem "$OPTION_WEPON", 'w', "WeponOptions"
	TextItem "$OPTION_NOTWEPON", 'o', "OptionsMenu"
	TextItem "$SAVEY_FILES", 's', "GameFilesMenu"
	TextItem "$FUCK_THIS", 'q', "QuitMenu" 
}

OptionMenu "WeponOptions"
{
	ScrollTop 2
	Title "$OPTION_TITLE"
	Submenu "$EXTRA_MENU", "AdonnOptions", 0, 1
	StaticText "$RESTART_MAP", "Green"
	StaticText ""
	Option "$FRAGBOX", "fragbox", "onoff"
	StaticText "$F_FRAGBOX", "Gray"
	StaticText "$F2_FRAGBOX", "Gray"
	StaticText ""
	Option "$ARMFIX", "barfix", "onoff"
	StaticText "$F_ARMFIX", "Gray"
	StaticText "$F2_ARMFIX", "Gray"
	StaticText ""
	Option "$ID24W", "id24crap", "onoff"
