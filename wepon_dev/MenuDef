	StaticText "$F1_BFGSPAWNB", "Gray"
	StaticText "$F2_BFGSPAWN", "Gray"
	StaticText "$F2_BFGSPAWNB", "Gray"
	StaticText ""
	Option "$BFGSKIN", "bfgSkin", "onoff"
