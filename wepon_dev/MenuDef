	StaticText "$F2_BFGSKIN", "Gray"
	StaticText "$F3_BFGSKIN", "Gray"
	StaticText ""
	Option "$STRONK_BFG", "stronkBFG", "onoff"
	StaticText "$F_STRONK_BFG", "Gray"
	StaticText "$F2_STRONK_BFG", "Gray"
	StaticText ""
	Option "$INFPIST", "altpistol", "onoff"
