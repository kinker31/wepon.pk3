[enu default]

ADONN_OPTION = "Option for Adonn";

GOLDPIST = "Golden Pistol of Destiny*:";
F1_GOLDPIST = "If enables, allows the titular weapon to spawn.";
F1_GOLDPISTB = "Uses an entirely seperate ammo pool that can rarely";
F2_GOLDPIST = "replace either large cell packs or BFG cells, but not fuel.";
F2_GOLDPISTB = "A little excessive, mind you.";

GOLDSPAWN = "Golden Spawnrate of Destiny*:";
F_GOLDSPAWN = "If the Golden Pistol can replace the BFG, how hard";
F2_GOLDSPAWN = "should it be to find and obtain one?";

ALTARMOR = "Alternate Armor Pickups*:";
F1_ALTARMOR = "Toggles the spawning of extra armor types.";
F2_ALTARMOR = "Gold Armor has a chance to replace green armor,";
F2_ALTARMORB = "and is an in-between of green/blue armor.";
F3_ALTARMOR = "Demon plating has a small chance to replace";
F3_ALTARMORB = "blue armor, and provides stupendous protection.";

SPHERE1 = "Blursphere(s) Status*:";
F_SPHERE1 = "Configues if blurspheres should be replaced with superspeed spheres.";
SPHERE2 = "Soulsphere(s) Status*:";
F_SPHERE2 = "Configues if soulspheres should be replaced with aegis spheres.";
SPHERE3 = "Godsphere(s) Status*:";
F_SPHERE3 = "Configues if invulnsshould be replaced with quad damage spheres.";
SPHERE4 = "Megasphere(s) Status*:";
F1_SPHERE4 = "Configues if megaspheres should be replaced with ultraspheres.";
F2_SPHERE4 = "(This option has no use whatsoever in Doom 1.)";

CHAINREP = "Replace the Twin-Bladed Chainsaw with*:";
F1_CHAINREP = "Use in Case of something like Slaughterfest or Goodwad.";
F2_CHAINREP = "Way too OP on a vanilla-esque mapset, use at your own discretion.";

SUPERWEP = "Spawn the Ultra Wepons*:";
F1_SUPERWEP = "If enabled, spawns more powerful (if less efficient) versions of your";
F2_SUPERWEP = "mid-tier weaponry to show up in your levels. Also applies to the";
F3_SUPERWEP = "id24-exclusive Incinerator as well if applicable.";

